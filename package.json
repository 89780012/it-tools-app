{
  "name": "it-tools-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd backend && go run .",
    "dev:full": "concurrently -k \"npm:dev\" \"npm:dev:api\"",
    "build": "tsc -b && vite build",
    "postbuild": "node script/generate-seo-pages.mjs",
    "preview": "vite preview",
    "start": "npm run preview",
    "lint": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:api": "cd backend && go test ./...",
    "test:browser": "playwright test",
    "check": "npm run build && npm run test:run && npm run test:api"
  },
