# Host port and bind address. Container always listens on 8080.
APP_PORT=8080
APP_BIND_ADDRESS=0.0.0.0

# Exact browser origins, separated by commas, without a trailing slash.
# For direct server access, add http://YOUR_SERVER_IP:8080.
# For a reverse proxy, add the public HTTPS origin instead.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://www.toolkitpub.com

# Optional: enable AI translation and language detection at runtime.
# These values are not included in the Docker image.
I18N_TRANSLATE_API_URL=
I18N_TRANSLATE_API_KEY=
I18N_TRANSLATE_API_MODEL=

# Optional: Let’s Encrypt DNS-01 issuance and certificate ZIP download.
CERTIFICATE_ISSUANCE_ENABLED=false
CERTIFICATE_ORIGIN=
CERTIFICATE_ACCESS_TOKEN=
CERTIFICATE_ACME_ENV=staging
CERTIFICATE_ACME_EMAIL=
CERTIFICATE_ACME_KEY_BASE64=
CERTIFICATE_ACME_ACCEPT_TOS=false
