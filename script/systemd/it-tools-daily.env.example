# systemd EnvironmentFile format: KEY=value (not shell commands).
DAILY_TOOL_MODE=deploy
DAILY_TOOL_TIMEZONE=Asia/Shanghai
DAILY_TOOL_AGENT_TIMEOUT=90m
DAILY_TOOL_CODEX_ATTEMPTS=4
DAILY_TOOL_RETRY_DELAY_SECONDS=60
DAILY_TOOL_GOPROXY=https://goproxy.cn

# Optional: use the model already configured in Codex when unset.
# DAILY_TOOL_MODEL=YOUR_MODEL

# If terminal API access depends on an HTTP proxy, configure it here too.
# systemd does not inherit shell startup files or the terminal environment.
# HTTP_PROXY=http://YOUR_PROXY_HOST:PORT
# HTTPS_PROXY=http://YOUR_PROXY_HOST:PORT
# NO_PROXY=localhost,127.0.0.1,::1
